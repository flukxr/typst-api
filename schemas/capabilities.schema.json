{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capabilities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "status", "features"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/capabilities.schema.json"
    },
    "status": {
      "enum": ["seed", "verified"]
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "warning": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "checkedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "features": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(commands|formats|options)\\.[A-Za-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["verification", "warning", "checkedAt", "evidence"],
        "properties": {
          "verification": true,
          "warning": true,
          "checkedAt": true,
          "evidence": true
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "exactStableVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milestone", "platform", "arch"],
      "properties": {
        "milestone": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "platform": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "arch": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "behaviorChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "change"],
      "properties": {
        "version": {
          "$ref": "#/$defs/exactStableVersion"
        },
        "change": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "since": {
          "anyOf": [
            {
              "$ref": "#/$defs/exactStableVersion"
            },
            {
              "type": "null"
            }
          ]
        },
        "knownPresentBy": {
          "$ref": "#/$defs/exactStableVersion"
        },
        "deprecatedIn": {
          "$ref": "#/$defs/exactStableVersion"
        },
        "removedIn": {
          "$ref": "#/$defs/exactStableVersion"
        },
        "experimental": {
          "type": "boolean"
        },
        "requiredFeature": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "apiPolicy": {
          "enum": ["blocked"]
        },
        "compatStrategy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "replacement": {
          "type": "string",
          "pattern": "^(commands|formats|options)\\.[A-Za-z][A-Za-z0-9]*$"
        },
        "behaviorChanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/behaviorChange"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binarySnapshots",
        "taggedSources",
        "officialChangelogs",
        "platform",
        "behaviorProbes"
      ],
      "properties": {
        "binarySnapshots": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "taggedSources": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "officialChangelogs": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "platform": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "behaviorProbes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
